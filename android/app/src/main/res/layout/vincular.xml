<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/papel">

    <androidx.camera.view.PreviewView
        android:id="@+id/vista"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vincular este celular a una mesa"
            android:textColor="@color/tinta"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Apunte la cámara al QR que muestra la web del torneo, o escriba el PIN." />

        <EditText
            android:id="@+id/servidor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Servidor (http://IP-del-PC:8080/ajedrez)"
            android:inputType="textUri" />

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="PIN de 6 dígitos"
            android:inputType="number"
            android:maxLength="6" />

        <TextView
            android:id="@+id/error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#B3261E"
            android:visibility="gone" />

        <Button
            android:id="@+id/vincular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Vincular" />
    </LinearLayout>
</LinearLayout>
